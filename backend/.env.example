# ==============================================================
# Arya Enterprises Maha E-Seva Kendra - Backend Environment Variables
# Copy this file to .env for local development.
# On Render Free: Configure these under "Environment Variables".
# ==============================================================

# Application Port (Render supplies its own PORT automatically)
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# JWT Authentication Secret Key (replace with a long random secret in production)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_characters

# Official Resend HTTPS API Key (starts with re_...)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Verified Sending Identity (must use a verified domain in Resend)
# For initial testing before domain verification: 'Arya Enterprises <onboarding@resend.dev>'
# For production: 'Arya Enterprises <contact@yourdomain.com>'
EMAIL_FROM=Arya Enterprises <onboarding@resend.dev>

# Recipient Address for Contact Form Enquiries (where you want to receive enquiries)
EMAIL_TO=anugadesanika@gmail.com

# Production Frontend URL for Strict CORS Protection (Vercel domain)
# Example: https://your-app-name.vercel.app
FRONTEND_URL=https://your-vercel-domain.vercel.app
